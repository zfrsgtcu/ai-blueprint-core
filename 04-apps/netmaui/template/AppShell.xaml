<!-- PURPOSE OF THIS FILE: Shell navigasyon yapısı — TabBar, Flyout, route register. Domain entity sayfaları burada. -->
<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:{{ProjectName}}.Views"
       x:Class="{{ProjectName}}.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Ana Sayfa"
            Icon="icon_home.png"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="home" />

        <ShellContent
            Title="{{ModelName}}s"
            Icon="icon_list.png"
            ContentTemplate="{DataTemplate views:{{ModelName}}sPage}"
            Route="{{model_names}}" />
    </TabBar>

    <!-- Detail sayfaları — route üzerinden navigate edilir -->
    <!-- Routing.RegisterRoute("{{model_name}}-detail", typeof({{ModelName}}DetailPage)); -->

</Shell>
