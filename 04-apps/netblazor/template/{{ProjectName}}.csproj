<!-- PURPOSE OF THIS FILE: Blazor WebAssembly proje dosyası — target framework, NuGet paketleri, AOT konfigürasyonu. -->
<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- AOT compilation (production build için önerilir) -->
    <!-- <RunAOTCompilation>true</RunAOTCompilation> -->
    <!-- WASM trimming -->
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.*" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.*" />
    <!-- Blazored kütüphaneleri (opsiyonel) -->
    <!-- <PackageReference Include="Blazored.LocalStorage" Version="4.5.*" /> -->
    <!-- <PackageReference Include="Blazored.Modal" Version="7.3.*" /> -->
  </ItemGroup>

</Project>
