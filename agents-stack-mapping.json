{
  "version": 2,
  "description": "Her stack'in frontend ve backend teknolojilerine göre hangi agent'ların çalıştırılacağını belirten mapping dosyası. Kurallar üstten alta değerlendirilir, ilk eşleşen uygulanır.",

  "categories": {
    "backend": {
      "subagents": ["dotnet-developer", "nodejs-developer", "database-developer"],
      "execution": "serial"
    },
    "frontend": {
      "subagents": ["astro-developer", "nuxt-developer", "ui-designer", "mobile-developer"],
      "execution": "serial"
    },
    "devops": {
      "subagents": ["vercel-deploy", "azure-deploy", "ci-cd-pipeline"],
      "execution": "parallel"
    },
    "qa": {
      "subagents": ["testing-strategy", "test-cases"],
      "execution": "serial"
    },
    "project-manager": {
      "subagents": ["requirements", "progress-tracking"],
      "execution": "serial"
    }
  },

  "stackAgentRules": [
    {
      "condition": {
        "frontend": ["astro-js"],
        "backend": ["none-required", "optional-nodejs"]
      },
      "agents": [
        {"category": "frontend", "subagent": "astro-developer"},
        {"category": "devops", "subagent": "vercel-deploy"}
      ],
      "note": "Static site (Kurumsal/Landing Page) — backend gerekmez"
    },
    {
      "condition": {
        "frontend": ["astro-js"],
        "backend": ["node-express-or-aspnet"]
      },
      "agents": [
        {"category": "backend", "subagent": "nodejs-developer"},
        {"category": "frontend", "subagent": "astro-developer"},
        {"category": "qa", "subagent": "testing-strategy"},
        {"category": "devops", "subagent": "ci-cd-pipeline"}
      ],
      "note": "Astro.js + Node.js/.NET full-stack (Haber/Dergi)"
    },
    {
      "condition": {
        "frontend": ["nuxt-js", "nuxt-js-or-blazor"],
        "backend": ["dotnet-webapi"]
      },
      "agents": [
        {"category": "backend", "subagent": "database-developer"},
        {"category": "backend", "subagent": "dotnet-developer"},
        {"category": "frontend", "subagent": "nuxt-developer"},
        {"category": "qa", "subagent": "testing-strategy"},
        {"category": "devops", "subagent": "azure-deploy"}
      ],
      "note": "Nuxt.js + .NET Web API (E-Ticaret, SaaS, LMS, Booking, vb.)"
    },
    {
      "condition": {
        "frontend": ["react-native-client-only"],
        "backend": ["dotnet-webapi"]
      },
      "agents": [
        {"category": "backend", "subagent": "database-developer"},
        {"category": "backend", "subagent": "dotnet-developer"},
        {"category": "frontend", "subagent": "mobile-developer"},
        {"category": "qa", "subagent": "testing-strategy"},
        {"category": "devops", "subagent": "azure-deploy"}
      ],
      "note": "React Native mobil uygulama — 'mobile' agent kullanılır (frontend yerine)"
    },
    {
      "condition": {
        "frontend": ["dotnet-maui"],
        "backend": ["dotnet-webapi"]
      },
      "agents": [
        {"category": "backend", "subagent": "database-developer"},
        {"category": "backend", "subagent": "dotnet-developer"},
        {"category": "frontend", "subagent": "mobile-developer"},
        {"category": "qa", "subagent": "testing-strategy"},
        {"category": "devops", "subagent": "azure-deploy"}
      ],
      "note": ".NET MAUI native mobil uygulama — frontend agent XAML/MAUI context ile çalışır"
    },
    {
      "condition": {
        "frontend": ["blazor-hybrid-maui"],
        "backend": ["dotnet-webapi"]
      },
      "agents": [
        {"category": "backend", "subagent": "database-developer"},
        {"category": "backend", "subagent": "dotnet-developer"},
        {"category": "frontend", "subagent": "mobile-developer"},
        {"category": "qa", "subagent": "testing-strategy"},
        {"category": "devops", "subagent": "azure-deploy"}
      ],
      "note": "Blazor Hybrid + MAUI hibrit mobil — frontend agent Blazor/JS Interop context ile çalışır"
    }
  ],

  "usageNotes": [
    "Kurallar üstten alta değerlendirilir, ilk eşleşen kural uygulanır.",
    "Yeni stack eklerken: stack.frontend ve stack.backend degerlerini kontrol et, uygun kural yoksa yeni bir rule ekle.",
    "departmentPrompts'ta null olan agent'lar workflow tarafindan skip edilecektir.",
    "mobile-agent key'i sadece react-native-client-only frontend'i olan stack'lerde kullanilir."
  ]
}
