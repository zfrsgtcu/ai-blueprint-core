{
  "_meta": {
    "description": "Enterprise API Contracts for Fitness Tracker Platform",
    "error_format": "{ status, code, message, details }",
    "rate_limiting": "Public: 500/min | Auth: 100/min | Coach: 200/min | Admin: 300/min"
  },
  "endpoints": {
    "public": {
      "GET /api/v1/exercises": "List exercise library (filter: muscleGroup, equipment, type, search)",
      "GET /api/v1/exercises/{id}": "Get exercise details with instructions and media",
      "GET /api/v1/workout-templates": "List public workout templates (filter: goal, level, duration)",
      "GET /api/v1/workout-templates/{id}": "Get template details with exercises",
      "GET /api/v1/challenges": "List active public challenges",
      "GET /api/v1/challenges/{id}": "Get challenge details with leaderboard",
      "GET /api/v1/leaderboards": "Get public leaderboards (filter: metric, timeframe, scope)",
      "GET /api/v1/food/search": "Search food database by name or barcode"
    },
    "auth": {
      "GET /api/v1/user/profile": "Get own profile with fitness metrics",
      "PUT /api/v1/user/profile": "Update profile and fitness settings",
      "PUT /api/v1/user/goals": "Update fitness goals and targets",
      "GET /api/v1/user/metrics": "Get body metrics history (filter: date range, metric type)",
      "POST /api/v1/user/metrics": "Log body measurement entry",
      "DELETE /api/v1/user/metrics/{id}": "Delete a measurement entry",
      "POST /api/v1/user/progress-photos": "Upload progress photo (front/side/back)",
      "GET /api/v1/user/progress-photos": "List progress photos",
      "DELETE /api/v1/user/progress-photos/{id}": "Delete progress photo",
      "POST /api/v1/user/health-sync": "Trigger sync with connected health apps",
      "GET /api/v1/user/prs": "List personal records",
      "GET /api/v1/user/stats": "Get workout statistics (streaks, volume, frequency)",
      "GET /api/v1/food/diary": "Get nutrition diary for date",
      "POST /api/v1/food/diary/meals": "Log meal with food items",
      "PUT /api/v1/food/diary/meals/{id}": "Edit meal entry",
      "DELETE /api/v1/food/diary/meals/{id}": "Delete meal entry",
      "POST /api/v1/food/diary/water": "Log water intake",
      "GET /api/v1/food/targets": "Get daily macro/calorie targets",
      "PUT /api/v1/food/targets": "Customize macro targets",
      "GET /api/v1/meal-plans": "List saved/available meal plans",
      "POST /api/v1/meal-plans": "Create custom meal plan",
      "PUT /api/v1/meal-plans/{id}": "Update meal plan",
      "DELETE /api/v1/meal-plans/{id}": "Delete meal plan",
      "POST /api/v1/workouts/session/start": "Start a new workout session",
      "POST /api/v1/workouts/session/{id}/log": "Log exercise set within session",
      "POST /api/v1/workouts/session/{id}/complete": "Complete workout session with notes",
      "PUT /api/v1/workouts/session/{id}": "Edit session details",
      "DELETE /api/v1/workouts/session/{id}": "Delete workout session",
      "GET /api/v1/workouts/history": "List workout history (filter: date, type, exercise)",
      "GET /api/v1/workouts/history/{id}": "Get full workout session details",
      "POST /api/v1/workouts/templates": "Save workout as personal template",
      "GET /api/v1/workouts/templates": "List personal workout templates",
      "PUT /api/v1/workouts/templates/{id}": "Update personal template",
      "DELETE /api/v1/workouts/templates/{id}": "Delete personal template",
      "GET /api/v1/exercises/custom": "List custom exercises by user",
      "POST /api/v1/exercises/custom": "Create custom exercise",
      "PUT /api/v1/exercises/custom/{id}": "Update custom exercise",
      "DELETE /api/v1/exercises/custom/{id}": "Delete custom exercise",
      "GET /api/v1/goals": "List personal goals with progress",
      "POST /api/v1/goals": "Create a new goal",
      "PUT /api/v1/goals/{id}": "Update goal (target, deadline, milestones)",
      "DELETE /api/v1/goals/{id}": "Delete goal",
      "POST /api/v1/goals/{id}/checkin": "Log progress toward goal",
      "POST /api/v1/challenges/{id}/join": "Join a challenge",
      "POST /api/v1/challenges/{id}/leave": "Leave a challenge",
      "GET /api/v1/social/feed": "Get activity feed (following + global)",
      "POST /api/v1/social/follow/{userId}": "Follow/unfollow user",
      "GET /api/v1/social/following": "List users being followed",
      "GET /api/v1/social/followers": "List followers",
      "POST /api/v1/workouts/{id}/like": "Like/kudos a shared workout",
      "POST /api/v1/workouts/{id}/comment": "Comment on a shared workout",
      "DELETE /api/v1/workouts/comments/{id}": "Delete own comment",
      "POST /api/v1/workouts/{id}/save": "Save workout to personal templates",
      "GET /api/v1/social/users/search": "Search users by username or name",
      "GET /api/v1/messages": "List conversations",
      "GET /api/v1/messages/{conversationId}": "Get conversation messages",
      "POST /api/v1/messages": "Send message",
      "POST /api/v1/messages/{conversationId}/share": "Share workout/meal plan in chat"
    },
    "coach": {
      "GET /api/v1/coach/clients": "List assigned clients",
      "GET /api/v1/coach/clients/{userId}": "Get client dashboard (activity, adherence, progress)",
      "POST /api/v1/coach/programs": "Create training/nutrition program",
      "PUT /api/v1/coach/programs/{id}": "Update program",
      "POST /api/v1/coach/programs/{id}/assign": "Assign program to client with schedule",
      "GET /api/v1/coach/checkins": "List client check-ins",
      "POST /api/v1/coach/checkins/{id}/respond": "Respond to client check-in",
      "GET /api/v1/coach/messages": "Coach-client messaging"
    },
    "admin": {
      "GET /api/v1/admin/exercises": "Manage global exercise library",
      "POST /api/v1/admin/exercises": "Add exercise to library",
      "PUT /api/v1/admin/exercises/{id}": "Update exercise",
      "DELETE /api/v1/admin/exercises/{id}": "Delete exercise",
      "GET /api/v1/admin/templates": "Manage workout templates",
      "POST /api/v1/admin/templates": "Create featured template",
      "PUT /api/v1/admin/templates/{id}": "Update template",
      "DELETE /api/v1/admin/templates/{id}": "Delete template",
      "GET /api/v1/admin/users": "User management list",
      "PUT /api/v1/admin/users/{id}/status": "Suspend/activate user",
      "GET /api/v1/admin/reports": "Content moderation queue",
      "PUT /api/v1/admin/reports/{id}": "Resolve report",
      "GET /api/v1/admin/stats": "Platform analytics dashboard",
      "GET /api/v1/admin/subscriptions": "Subscription and revenue overview",
      "POST /api/v1/admin/promo-codes": "Create promotional code",
      "GET /api/v1/admin/challenges": "Manage platform challenges",
      "POST /api/v1/admin/challenges": "Create platform challenge",
      "PUT /api/v1/admin/challenges/{id}": "Update challenge"
    }
  }
}
