{
  "_meta": {
    "description": "Secrets yönetimi manifesti — environment variables, .env dosyaları, Vault entegrasyonu ve gizli veri güvenliği tanımları. AI ajanları gizli yönetimi konfigürasyonlarını bu manifest'teki kurallara göre üretir.",
    "lock_policy": "strict",
    "last_updated": "2026-07-20",
    "blueprint_version": "1.0.0"
  },

  "secret_categories": {
    "application": {
      "label": "Uygulama Gizlileri",
      "secrets": [
        { "key": "JWT_SECRET", "type": "string", "min_length": 32, "generate": true, "description": "JWT token imzalama anahtarı" },
        { "key": "API_KEY", "type": "string", "min_length": 32, "generate": true, "description": "Uygulama içi API anahtarı" },
        { "key": "ENCRYPTION_KEY", "type": "string", "min_length": 32, "generate": true, "description": "Simetrik şifreleme anahtarı (AES-256)" },
        { "key": "SESSION_SECRET", "type": "string", "min_length": 32, "generate": true, "description": "Oturum şifreleme anahtarı" }
      ]
    },
    "database": {
      "label": "Veritabanı Gizlileri",
      "secrets": [
        { "key": "DB_PASSWORD", "type": "string", "min_length": 16, "generate": true, "description": "Veritabanı kullanıcı şifresi" },
        { "key": "DB_CONNECTION_STRING", "type": "connection_string", "build_from": ["DB_SERVER", "DB_NAME", "DB_USER", "DB_PASSWORD"], "description": "Tam bağlantı string'i" },
        { "key": "REDIS_PASSWORD", "type": "string", "min_length": 16, "generate": true, "description": "Redis şifresi (opsiyonel)" }
      ]
    },
    "external_services": {
      "label": "Harici Servis Gizlileri",
      "secrets": [
        { "key": "SMTP_PASSWORD", "type": "string", "description": "Email servisi şifresi" },
        { "key": "STRIPE_SECRET_KEY", "type": "string", "prefix": "sk_", "description": "Stripe API secret key" },
        { "key": "AZURE_CLIENT_SECRET", "type": "string", "description": "Azure AD client secret" },
        { "key": "SENTRY_AUTH_TOKEN", "type": "string", "description": "Sentry error tracking token" },
        { "key": "GOOGLE_ANALYTICS_ID", "type": "string", "description": "Google Analytics ölçüm ID'si" }
      ]
    },
    "infrastructure": {
      "label": "Altyapı Gizlileri",
      "secrets": [
        { "key": "GRAFANA_ADMIN_PASSWORD", "type": "string", "min_length": 12, "generate": true, "description": "Grafana admin panel şifresi" },
        { "key": "VERCEL_TOKEN", "type": "string", "description": "Vercel deployment token" },
        { "key": "AZURE_PUBLISH_PROFILE", "type": "string", "description": "Azure App Service publish profile" },
        { "key": "REGISTRY_PASSWORD", "type": "string", "description": "Container registry şifresi" },
        { "key": "SLACK_WEBHOOK_URL", "type": "url", "description": "Slack alert/notification webhook" },
        { "key": "DISCORD_WEBHOOK_URL", "type": "url", "description": "Discord notification webhook" }
      ]
    }
  },

  "environments": {
    "development": {
      "file": ".env.development",
      "loaded_by": "docker-compose up (otomatik)",
      "git_tracked": false,
      "note": "Lokal geliştirme ortamı. Default değerler içerebilir, canlı secret'lar ASLA."
    },
    "staging": {
      "file": ".env.staging",
      "loaded_by": "CI/CD pipeline (GitHub Secrets / GitLab Variables)",
      "git_tracked": false,
      "note": "Test ortamı. Canlı servislerin test API anahtarları."
    },
    "production": {
      "file": ".env.production",
      "loaded_by": "CI/CD pipeline VEYA secret manager (Vault / Azure Key Vault)",
      "git_tracked": false,
      "note": "Canlı ortam. TÜM değerler secret manager'dan gelmeli, ASLA dosyada olmamalı."
    }
  },

  "secret_management_strategies": {
    "development": {
      "method": ".env dosyası",
      "template_file": ".env.example",
      "description": "Geliştirici kendi .env dosyasını oluşturur"
    },
    "ci_cd": {
      "method": "GitHub Secrets / GitLab CI Variables",
      "masked_in_logs": true,
      "description": "CI/CD pipeline'ında environment variable olarak enjekte edilir"
    },
    "production_standard": {
      "method": "Azure Key Vault",
      "description": "Azure App Service veya Container Apps ile entegre, otomatik rotasyon"
    },
    "production_advanced": {
      "method": "HashiCorp Vault",
      "description": "Self-hosted veya HCP Vault, dynamic secrets, audit logging"
    },
    "production_docker": {
      "method": "Docker Secrets",
      "description": "Docker Swarm ortamlarında, /run/secrets/ altına mount edilir"
    }
  },

  "non_secret_variables": {
    "label": "Gizli OLMAYAN (env.example'da gösterilebilir)",
    "variables": [
      { "key": "NODE_ENV", "example": "production", "description": "Node.js ortam modu" },
      { "key": "ASPNETCORE_ENVIRONMENT", "example": "Production", "description": ".NET ortam modu" },
      { "key": "PORT", "example": "3000", "description": "Uygulama portu" },
      { "key": "DB_SERVER", "example": "db", "description": "Veritabanı sunucu adresi" },
      { "key": "DB_NAME", "example": "myapp", "description": "Veritabanı adı" },
      { "key": "DB_USER", "example": "myapp_user", "description": "Veritabanı kullanıcı adı" },
      { "key": "DOMAIN", "example": "myapp.com", "description": "Ana domain" },
      { "key": "ADMIN_EMAIL", "example": "admin@myapp.com", "description": "Yönetici email adresi" },
      { "key": "SMTP_HOST", "example": "smtp.sendgrid.net", "description": "Email SMTP sunucusu" },
      { "key": "SMTP_PORT", "example": "587", "description": "Email SMTP portu" },
      { "key": "SMTP_USER", "example": "apikey", "description": "Email SMTP kullanıcı adı" },
      { "key": "LOG_LEVEL", "example": "info", "description": "Log seviyesi" }
    ]
  },

  "security_rules": {
    "never_commit": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "*.pfx",
      "secrets.yaml",
      "appsettings.*.json (local secret içerenler)",
      "credentials.json"
    ],
    "never_hardcode": [
      "API anahtarları",
      "Veritabanı şifreleri",
      "JWT secret'ları",
      "Connection string'leri (şifre içeren)",
      "3. parti servis token'ları",
      "Encryption key'ler"
    ],
    "secret_naming_convention": "SCREAMING_SNAKE_CASE",
    "dot_env_example_required": true,
    "gitignore_checklist": [
      ".env",
      ".env.local",
      ".env.development",
      ".env.staging",
      ".env.production",
      "*.pem",
      "*.key",
      "*.pfx",
      "secrets.yaml",
      "secrets.yml",
      "credentials.json",
      "*.secret"
    ]
  }
}
