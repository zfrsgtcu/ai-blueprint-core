{
  "id": "admin-panel",
  "name": "Özel Yönetim Paneli (Admin)",
  "description": "İç yönetim dashboard'ları, veri yönetimi, raporlama ve Excel/PDF export özellikleri.",
  "type": "internal-admin",

  "stack": {
    "frontend": "nuxt-js-or-blazor",
    "backend": "dotnet-webapi",
    "database": "mssql-natro",
    "deploy": "vercel-azure"
  },

  "uiLibraries": [
    { "name": "tailwindcss", "version": "^3.4.0", "usage": "primary-styling-or-blazor-components" },
    { "name": "google-fonts", "usage": "typography" },
    { "name": "iconify", "usage": "icons" },
    { "name": "gsap", "version": "^3.12.0", "usage": "optional-notification-transitions" },
    { "name": "swiperjs", "version": "^11.0.0", "usage": "rarely-used-dashboards" },
    { "name": "fancybox", "version": "^3.0.0", "usage": "image-preview-widgets" }
  ],

  "extraServices": [
    { "name": "identity-service", "provider": "persona", "purpose": "admin-authentication" },
    { "name": "reporting-export", "provider": "custom-or-third-party", "purpose": "excel-pdf-generation" },
    { "name": "charting-library", "provider": "chartjs-or-echarts", "purpose": "data-visualization-analytics" }
  ],

  "compliance": [
    "kvkk",
    "gdpr",
    "internal-audit-trail"
  ],

  "features": [
    "admin-authentication",
    "user-management",
    "content-management",
    "data-export-excel-pdf",
    "charts-analytics-dashboard",
    "audit-logging",
    "role-based-access-control",
    "responsive-design"
  ],

  "designGuidelines": {
    "style": "functional-admin-focused",
    "typography": "sans-serif-readable-data-dense",
    "colorPalette": "neutral-professional",
    "imagery": "minimal-icons-data-viz",
    "animations": "subtle-table-row-transitions"
  },

  "departmentPrompts": {
    "backend": ".NET Web API ile admin panel backend'i oluştur. MSSQL veritabanı ile kullanıcı yönetimi ve raporlama. Excel/PDF export servisleri.",
    "frontend": "Nuxt.js veya Blazor ile admin dashboard oluştur. Chart.js/ECharts ile grafikler. TailwindCSS (Nuxt) veya native components (Blazor) ile tasarım yap.",
    "qa": "Yetkilendirme testi, veri export akışı testi, rol bazlı erişim kontrolü testi yap.",
    "devops": "Vercel (Nuxt) veya Azure (Blazor) deploy et."
  },

  "performanceTargets": {
    "lighthouse": 80,
    "firstContentfulPaint": "<2s",
    "largestContentfulPaint": "<3.5s",
    "cumulativeLayoutShift": "<0.1"
  },

  "docs": {
    "nuxtjs": [
      { "name": "Ana Dokümantasyon", "url": "https://nuxt.com/docs" },
      { "name": "Getting Started", "url": "https://nuxt.com/docs/getting-started/introduction" }
    ],
    "blazor": [
      { "name": "Ana Dokümantasyon", "url": "https://learn.microsoft.com/aspnet/core/blazor" },
      { "name": "Getting Started", "url": "https://learn.microsoft.com/aspnet/core/blazor/get-started" },
      { "name": "Blazor Components", "url": "https://learn.microsoft.com/aspnet/core/blazor/components" }
    ],
    "dotnet-webapi": [
      { "name": "Ana Dokümantasyon", "url": "https://learn.microsoft.com/aspnet/core" },
      { "name": "Create a Web API", "url": "https://learn.microsoft.com/aspnet/core/tutorials/first-web-api" }
    ],
    "mssql": [
      { "name": "Ana Dokümantasyon", "url": "https://learn.microsoft.com/sql" },
      { "name": "T-SQL Tutorial", "url": "https://learn.microsoft.com/sql/t-sql/tutorial-writing-transact-sql-statements" }
    ],
    "persona": [
      { "name": "Ana Dokümantasyon", "url": "https://help.withpersona.com" },
      { "name": "API Introduction", "url": "https://docs.withpersona.com/reference/introduction" }
    ]
  }
}
