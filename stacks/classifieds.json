{
  "id": "classifieds",
  "name": "İlan & Sınıflandırılmış (Emlak, Araç)",
  "description": "İlan paylaşma platformları. Harita entegrasyonu, gelişmiş filtreleme, görsel galeri.",
  "type": "dynamic-classifieds",

  "stack": {
    "frontend": "nuxt-js",
    "backend": "dotnet-webapi",
    "database": "mssql-natro",
    "deploy": "vercel-azure"
  },

  "uiLibraries": [
    { "name": "tailwindcss", "version": "^3.4.0", "usage": "primary-styling" },
    { "name": "google-fonts", "usage": "typography" },
    { "name": "iconify", "usage": "icons" },
    { "name": "swiperjs", "version": "^11.0.0", "usage": "listing-gallery-carousel" },
    { "name": "fancybox", "version": "^3.0.0", "usage": "photo-lightbox-detail-view" }
  ],

  "extraServices": [
    { "name": "map-service", "provider": "google-maps-or-mapbox", "purpose": "location-display-filters" },
    { "name": "advanced-search", "provider": "algolia-or-elastic", "purpose": "full-text-filtering" }
  ],

  "compliance": [
    "kvkk",
    "gdpr",
    "consumer-protection"
  ],

  "features": [
    "listing-management",
    "photo-upload-gallery",
    "map-integration",
    "advanced-filters",
    "user-authentication",
    "messaging-system",
    "responsive-design",
    "seo-optimized"
  ],

  "designGuidelines": {
    "style": "clean-listing-focused",
    "typography": "sans-serif-readable",
    "colorPalette": "trust-neutrality",
    "imagery": "property-vehicle-photos",
    "animations": "subtle-listing-interactions"
  },

  "departmentPrompts": {
    "backend": ".NET Web API ile ilan platformu backend'i oluştur. MSSQL veritabanı ile ilan, kullanıcı ve mesaj yönetimi. Google Maps entegrasyonu.",
    "frontend": "Nuxt.js ile SSR ilan sitesi oluştur. SwiperJS ile ilan galerisi. Fancybox ile photo lightbox. Harita entegrasyonu. TailwindCSS ile responsive tasarım yap.",
    "qa": "Harita filtreleme testi, ilan yükleme akışı testi, mesajlaşma sistemi testi yap.",
    "devops": "Vercel (frontend) + Azure (backend/API) deploy et."
  },

  "performanceTargets": {
    "lighthouse": 85,
    "firstContentfulPaint": "<1.5s",
    "largestContentfulPaint": "<3s",
    "cumulativeLayoutShift": "<0.1"
  },

  "docs": {
    "nuxtjs": [
      { "name": "Ana Dokümantasyon", "url": "https://nuxt.com/docs" },
      { "name": "Getting Started", "url": "https://nuxt.com/docs/getting-started/introduction" },
      { "name": "Routing", "url": "https://nuxt.com/docs/getting-started/routing" }
    ],
    "dotnet-webapi": [
      { "name": "Ana Dokümantasyon", "url": "https://learn.microsoft.com/aspnet/core" },
      { "name": "Create a Web API", "url": "https://learn.microsoft.com/aspnet/core/tutorials/first-web-api" }
    ],
    "mssql": [
      { "name": "Ana Dokümantasyon", "url": "https://learn.microsoft.com/sql" },
      { "name": "T-SQL Tutorial", "url": "https://learn.microsoft.com/sql/t-sql/tutorial-writing-transact-sql-statements" }
    ],
    "tailwindcss": [
      { "name": "Ana Dokümantasyon", "url": "https://tailwindcss.com/docs" },
      { "name": "Installation", "url": "https://v3.tailwindcss.com/docs/installation" }
    ],
    "swiperjs": [
      { "name": "Ana Dokümantasyon", "url": "https://swiperjs.com/get-started" },
      { "name": "API Documentation", "url": "https://swiperjs.com/swiper-api" }
    ],
    "fancybox": [
      { "name": "Ana Dokümantasyon", "url": "https://fancyapps.com/fancybox" },
      { "name": "Usage Guide", "url": "https://fancyapps.com/fancybox/usage" }
    ]
  }
}
