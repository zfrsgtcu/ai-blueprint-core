{
  "id": "news-magazine",
  "name": "Haber & Dergi Sitesi",
  "description": "İçerik yoğun, SEO odaklı haber/dergi siteleri. Slider, galeri, arama ve newsletter entegrasyonu.",
  "type": "dynamic-cms",

  "stack": {
    "frontend": "astro-js",
    "backend": "node-express-or-aspnet",
    "database": "mssql-natro",
    "deploy": "vercel-fullstack"
  },

  "uiLibraries": [
    { "name": "tailwindcss", "version": "^3.4.0", "usage": "primary-styling" },
    { "name": "google-fonts", "usage": "typography" },
    { "name": "iconify", "usage": "icons" },
    { "name": "swiperjs", "version": "^11.0.0", "usage": "news-slider-featured-content" },
    { "name": "fancybox", "version": "^3.0.0", "usage": "photo-gallery-lightbox" }
  ],

  "extraServices": [
    { "name": "newsletter-service", "provider": "mailchimp-or-sendgrid", "purpose": "email-subscriptions" },
    { "name": "comment-system", "provider": "disqus-or-custom", "purpose": "user-comments" },
    { "name": "search-engine", "provider": "algolia-or-elastic", "purpose": "full-text-search" }
  ],

  "compliance": [
    "kvkk",
    "gdpr",
    "copyright"
  ],

  "features": [
    "news-slider",
    "photo-gallery",
    "search-functionality",
    "newsletter-subscription",
    "comment-system",
    "social-sharing",
    "seo-optimized",
    "responsive-design"
  ],

  "designGuidelines": {
    "style": "editorial-magazine",
    "typography": "serif-headlines-sans-serif-body",
    "colorPalette": "high-contrast-news",
    "imagery": "hero-images-photo-journalism",
    "animations": "subtle-content-focused"
  },

  "departmentPrompts": {
    "backend": "Node.js veya .NET API oluştur. MSSQL veritabanı ile haber yönetimi, kullanıcı yorumları ve newsletter abonelikleri için endpoints yaz.",
    "frontend": "Astro.js ile SSR/SSG hybrid site oluştur. SwiperJS ile haber slider'ı yap. Fancybox ile fotoğraf galerisi ekle. TailwindCSS ile responsive tasarım yap.",
    "qa": "SEO testleri, arama fonksiyonu testi, newsletter abonelik akışı testi yap.",
    "devops": "Vercel'de full-stack deploy et. MSSQL bağlantısını yapılandır."
  },

  "performanceTargets": {
    "lighthouse": 85,
    "firstContentfulPaint": "<1.5s",
    "largestContentfulPaint": "<3s",
    "cumulativeLayoutShift": "<0.1"
  },

  "docs": {
    "astro": [
      { "name": "Ana Dokümantasyon", "url": "https://docs.astro.build" },
      { "name": "Getting Started", "url": "https://docs.astro.build/en/getting-started/" },
      { "name": "Styling & CSS", "url": "https://docs.astro.build/en/guides/styling/" }
    ],
    "nodejs": [
      { "name": "Ana Dokümantasyon", "url": "https://nodejs.org/en/docs" },
      { "name": "API Reference", "url": "https://nodejs.org/api/" },
      { "name": "Getting Started Guide", "url": "https://nodejs.org/en/docs/guides/getting-started-guide/" }
    ],
    "tailwindcss": [
      { "name": "Ana Dokümantasyon", "url": "https://tailwindcss.com/docs" },
      { "name": "Installation", "url": "https://v3.tailwindcss.com/docs/installation" }
    ],
    "swiperjs": [
      { "name": "Ana Dokümantasyon", "url": "https://swiperjs.com/get-started" },
      { "name": "API Documentation", "url": "https://swiperjs.com/swiper-api" }
    ],
    "fancybox": [
      { "name": "Ana Dokümantasyon", "url": "https://fancyapps.com/fancybox" },
      { "name": "Usage Guide", "url": "https://fancyapps.com/fancybox/usage" }
    ],
    "vercel": [
      { "name": "Ana Dokümantasyon", "url": "https://vercel.com/docs" },
      { "name": "Getting Started", "url": "https://vercel.com/docs/getting-started" },
      { "name": "Hosting APIs on Vercel", "url": "https://vercel.com/docs/functions" }
    ]
  }
}
