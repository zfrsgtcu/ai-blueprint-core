{
  "id": "corporate-portfolio",
  "name": "Kurumsal & Portfolyo (CMS, Blog)",
  "description": "Avukatlık bürosu, şirket tanıtım, portfolyo siteleri. SEO odaklı, hızlı yükleme, görsel şov.",
  "type": "static-cms",

  "stack": {
    "frontend": "astro-js",
    "backend": "optional-nodejs",
    "database": "none-or-sqlite",
    "deploy": "vercel",
    "cms": "headless-cms"
  },

  "uiLibraries": [
    { "name": "tailwindcss", "version": "^3.4.0", "usage": "primary-styling" },
    { "name": "google-fonts", "usage": "typography" },
    { "name": "iconify", "usage": "icons" },
    { "name": "gsap", "version": "^3.12.0", "usage": "animations-hero-sections" },
    { "name": "swiperjs", "version": "^11.0.0", "usage": "carousels-galleries" },
    { "name": "fancybox", "version": "^3.0.0", "usage": "lightbox-photo-gallery" }
  ],

  "extraServices": [],

  "compliance": [
    "kvkk",
    "gdpr"
  ],

  "features": [
    "contact-form",
    "team-profiles",
    "blog-cms",
    "seo-optimized",
    "responsive-design",
    "performance-score-90-plus"
  ],

  "designGuidelines": {
    "style": "professional-corporate",
    "typography": "serif-or-sans-serif",
    "colorPalette": "brand-dependent",
    "imagery": "office-photos-team-portraits",
    "animations": "subtle-professional"
  },

  "departmentPrompts": {
    "backend": null,
    "frontend": "Astro.js ile statik site oluştur. SEO için sSG kullan. TailwindCSS ile responsive tasarım yap. GSAP ile hero animasyonları ekle.",
    "devops": "Vercel'e deploy et. Custom domain yapılandır. SSL sertifikası kur."
  },

  "performanceTargets": {
    "lighthouse": 90,
    "firstContentfulPaint": "<1s",
    "largestContentfulPaint": "<2.5s",
    "cumulativeLayoutShift": "<0.1"
  },

  "docs": {
    "astro": [
      { "name": "Ana Dokümantasyon", "url": "https://docs.astro.build" },
      { "name": "Getting Started", "url": "https://docs.astro.build/en/getting-started/" },
      { "name": "Project Structure", "url": "https://docs.astro.build/en/basics/project-structure/" },
      { "name": "Configuration Reference", "url": "https://docs.astro.build/en/reference/configuration-reference/" },
      { "name": "Styling & CSS", "url": "https://docs.astro.build/en/guides/styling/" },
      { "name": "Deployment", "url": "https://docs.astro.build/en/guides/deploy/" }
    ],
    "preview-photo": [
      { "name": "Ana Dokümantasyon", "url": "https://unsplash.com/documentation" },
      { "name": "Getting Started", "url": "https://unsplash.com/developers" },
      { "name": "Best Practices", "url": "https://unsplash.com/documentation#search-photos" }
    ],
    "tailwindcss": [
      { "name": "Ana Dokümantasyon", "url": "https://tailwindcss.com/docs" },
      { "name": "Installation", "url": "https://v3.tailwindcss.com/docs/installation" },
      { "name": "Astro JS ile uyumlu Tailwind", "url": "https://docs.astro.build/en/guides/styling/#tailwind" },
      { "name": "Framework Guides", "url": "https://v3.tailwindcss.com/docs/guides" },
      { "name": "Configuration", "url": "https://tailwindcss.com/docs/configuration" },
      { "name": "Core Concepts", "url": "https://tailwindcss.com/docs/utility-first" }
    ],
    "google-fonts": [
      { "name": "Ana Dokümantasyon", "url": "https://fonts.google.com" },
      { "name": "Getting Started with API", "url": "https://developers.google.cn/fonts/docs/getting_started" },
      { "name": "CSS API Update (v2)", "url": "https://developers.google.com/fonts/docs/css2" }
    ],
    "iconify": [
      { "name": "Ana Dokümantasyon", "url": "https://iconify.design/docs" },
      { "name": "Astro JS Iconify", "url": "https://iconify.design/docs/usage/svg/astro/" },
      { "name": "Usage Guide", "url": "https://iconify.design/docs/usage/" },
      { "name": "Icon Components", "url": "https://iconify.design/docs/icon-components/" }
    ],
    "gsap": [
      { "name": "Ana Dokümantasyon", "url": "https://gsap.com/docs" },
      { "name": "Getting Started", "url": "https://gsap.com/docs/v3/GettingStarted" },
      { "name": "Best Practices", "url": "https://gsap.com/docs/v3/GSAP/BestPractices" }
    ],
    "swiperjs": [
      { "name": "Ana Dokümantasyon", "url": "https://swiperjs.com/get-started" },
      { "name": "API Documentation", "url": "https://swiperjs.com/swiper-api" },
      { "name": "Demos", "url": "https://swiperjs.com/demos" }
    ],
    "fancybox": [
      { "name": "Ana Dokümantasyon", "url": "https://fancyapps.com/fancybox" },
      { "name": "Usage Guide", "url": "https://fancyapps.com/fancybox/usage" },
      { "name": "API Reference", "url": "https://fancyapps.com/fancybox/api" }
    ],
    "vercel": [
      { "name": "Ana Dokümantasyon", "url": "https://vercel.com/docs" },
      { "name": "Getting Started", "url": "https://vercel.com/docs/getting-started" },
      { "name": "Projects & Configuration", "url": "https://vercel.com/docs/projects" }
    ]
  }
}
