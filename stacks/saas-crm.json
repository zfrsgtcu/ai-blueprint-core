{
  "id": "saas-crm",
  "name": "SaaS / CRM (Multi-tenant)",
  "description": "Bulut tabanlı yazılım, çoklu kiracı mimarisi, abonelik yönetimi, rol bazlı erişim kontrolü.",
  "type": "multi-tenant-saas",

  "stack": {
    "frontend": "nuxt-js",
    "backend": "dotnet-webapi",
    "database": "mssql-natro",
    "deploy": "vercel-azure"
  },

  "uiLibraries": [
    { "name": "tailwindcss", "version": "^3.4.0", "usage": "primary-styling" },
    { "name": "google-fonts", "usage": "typography" },
    { "name": "iconify", "usage": "icons" },
    { "name": "gsap", "version": "^3.12.0", "usage": "onboarding-welcome-animations-only" },
    { "name": "swiperjs", "version": "^11.0.0", "usage": "optional-dashboards-widgets" },
    { "name": "fancybox", "version": "^3.0.0", "usage": "rarely-used-image-preview" }
  ],

  "extraServices": [
    { "name": "payment-gateway", "provider": "stripe-or-iyzico", "purpose": "subscription-billing-recurring" },
    { "name": "identity-service", "provider": "persona", "purpose": "user-verification-kyc" }
  ],

  "compliance": [
    "kvkk",
    "gdpr",
    "iso27001",
    "soc2"
  ],

  "features": [
    "multi-tenant-isolation",
    "user-roles-rbac",
    "subscription-billing",
    "api-access",
    "analytics-dashboard",
    "reporting-module",
    "audit-logging",
    "sso-integration"
  ],

  "designGuidelines": {
    "style": "saas-modern-minimal",
    "typography": "sans-serif-clean",
    "colorPalette": "brand-trust-professional",
    "imagery": "dashboard-illustrations-data-viz",
    "animations": "minimal-onboarding-only"
  },

  "departmentPrompts": {
    "backend": ".NET Web API ile multi-tenant SaaS backend'i oluştur. MSSQL veritabanı ile tenant izolasyonu, kullanıcı rolleri ve abonelik yönetimi. Stripe/iyzico tekrarlayan ödeme entegrasyonu.",
    "frontend": "Nuxt.js ile SSR SaaS uygulaması oluştur. Dashboard widget'ları. GSAP ile onboarding animasyonları (sadece ilk girişte). TailwindCSS ile responsive tasarım yap.",
    "qa": "Multi-tenant isolation testi, RBAC yetkilendirme testi, abonelik yenileme akışı testi yap.",
    "devops": "Vercel (frontend) + Azure (backend/API) deploy et. Multi-tenant veritabanı yapılandırması."
  },

  "performanceTargets": {
    "lighthouse": 85,
    "firstContentfulPaint": "<1.5s",
    "largestContentfulPaint": "<3s",
    "cumulativeLayoutShift": "<0.1"
  },

  "docs": {
    "nuxtjs": [
      { "name": "Ana Dokümantasyon", "url": "https://nuxt.com/docs" },
      { "name": "Getting Started", "url": "https://nuxt.com/docs/getting-started/introduction" }
    ],
    "dotnet-webapi": [
      { "name": "Ana Dokümantasyon", "url": "https://learn.microsoft.com/aspnet/core" },
      { "name": "Create a Web API", "url": "https://learn.microsoft.com/aspnet/core/tutorials/first-web-api" }
    ],
    "mssql": [
      { "name": "Ana Dokümantasyon", "url": "https://learn.microsoft.com/sql" },
      { "name": "T-SQL Tutorial", "url": "https://learn.microsoft.com/sql/t-sql/tutorial-writing-transact-sql-statements" }
    ],
    "stripe": [
      { "name": "Ana Dokümantasyon", "url": "https://docs.stripe.com" },
      { "name": "API Reference", "url": "https://docs.stripe.com/api" },
      { "name": "Subscription Billing", "url": "https://docs.stripe.com/billing" }
    ],
    "persona": [
      { "name": "Ana Dokümantasyon", "url": "https://help.withpersona.com" },
      { "name": "API Introduction", "url": "https://docs.withpersona.com/reference/introduction" }
    ]
  }
}
