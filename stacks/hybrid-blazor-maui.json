{
  "id": "hybrid-blazor-maui",
  "name": "Hibrit (Blazor + MAUI)",
  "description": "Blazor Hybrid ile .NET MAUI uygulaması. Web teknolojileri ile native mobil deneyim, dosya yönetimi ve offline support.",
  "type": "hybrid-mobile-blazor-maui",

  "stack": {
    "frontend": "blazor-hybrid-maui",
    "backend": "dotnet-webapi",
    "database": "mssql-natro-or-local-sqlite",
    "deploy": "azure-and-stores"
  },

  "uiLibraries": [
    { "name": "tailwindcss", "version": "^3.4.0", "usage": "blazor-component-styling" },
    { "name": "google-fonts", "usage": "typography-in-blazor" },
    { "name": "iconify", "usage": "icons-in-blazor" },
    { "name": "swiperjs", "version": "^11.0.0", "usage": "blazor-js-interop-carousel" },
    { "name": "gsap", "version": "^3.12.0", "usage": "blazor-js-Interop-animations" }
  ],

  "extraServices": [
    { "name": "identity-service", "provider": "persona", "purpose": "user-authentication" },
    { "name": "file-management", "provider": "azure-blob-or-local-storage", "purpose": "document-file-handling" }
  ],

  "compliance": [
    "kvkk",
    "gdpr",
    "mobile-data-protection",
    "app-store-guidelines"
  ],

  "features": [
    "blazor-hybrid-components",
    "native-maui-integration",
    "file-document-management",
    "offline-capability-sqlite",
    "push-notifications",
    "cross-platform-deployment",
    "responsive-adaptive-ui"
  ],

  "designGuidelines": {
    "style": "blazor-web-with-native-integration",
    "typography": "web-fonts-via-blazor",
    "colorPalette": "brand-consistent-across-platforms",
    "imagery": "web-assets-with-native-adaptation",
    "animations": "blazor-animations-javascript-interop"
  },

  "departmentPrompts": {
    "backend": ".NET Web API ile hybrid mobile backend oluştur. MSSQL veya SQLite local database sync desteği. Dosya yönetimi servisi.",
    "frontend": "Blazor Hybrid (.NET MAUI) ile hibrit mobil uygulama geliştir. TailwindCSS ile component styling. SwiperJS ve GSAP JS Interop ile kullanılabilir. Native MAUI integration noktaları belirle.",
    "qa": "Blazor-JS interop testleri, native integration testleri, offline sync testi yap.",
    "devops": "Azure'da API deploy et. MAUI build pipeline yapılandır. Store deployment."
  },

  "performanceTargets": {
    "appLaunchTime": "<2.5s",
    "offlineSyncLatency": "<500ms",
    "memoryUsage": "optimized-for-mobile"
  },

  "docs": {
    "blazor-hybrid": [
      { "name": "Ana Dokümantasyon", "url": "https://learn.microsoft.com/aspnet/core/blazor/hybrid" },
      { "name": "Blazor Components", "url": "https://learn.microsoft.com/aspnet/core/blazor/components" },
      { "name": "Blazor Server vs WebAssembly", "url": "https://learn.microsoft.com/aspnet/core/blazor/hosting-models" }
    ],
    "dotnet-maui": [
      { "name": "Ana Dokümantasyon", "url": "https://learn.microsoft.com/dotnet/maui" },
      { "name": "Getting Started", "url": "https://dotnet.microsoft.com/apps/maui/get-started" },
      { "name": "XAML & Data Binding", "url": "https://learn.microsoft.com/dotnet/maui/xaml" }
    ],
    "dotnet-webapi": [
      { "name": "Ana Dokümantasyon", "url": "https://learn.microsoft.com/aspnet/core" },
      { "name": "Create a Web API", "url": "https://learn.microsoft.com/aspnet/core/tutorials/first-web-api" }
    ],
    "mssql": [
      { "name": "Ana Dokümantasyon", "url": "https://learn.microsoft.com/sql" },
      { "name": "T-SQL Tutorial", "url": "https://learn.microsoft.com/sql/t-sql/tutorial-writing-transact-sql-statements" }
    ],
    "persona": [
      { "name": "Ana Dokümantasyon", "url": "https://help.withpersona.com" },
      { "name": "API Introduction", "url": "https://docs.withpersona.com/reference/introduction" }
    ]
  }
}
