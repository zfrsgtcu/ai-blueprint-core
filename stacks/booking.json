{
  "id": "booking",
  "name": "Randevu / Booking / Bilet",
  "description": "Randevu, bilet ve rezervasyon sistemleri. Takvim entegrasyonu, SMS/WhatsApp hatırlatma, ödeme.",
  "type": "dynamic-booking",

  "stack": {
    "frontend": "nuxt-js",
    "backend": "dotnet-webapi",
    "database": "mssql-natro",
    "deploy": "vercel-azure"
  },

  "uiLibraries": [
    { "name": "tailwindcss", "version": "^3.4.0", "usage": "primary-styling" },
    { "name": "google-fonts", "usage": "typography" },
    { "name": "iconify", "usage": "icons" },
    { "name": "swiperjs", "version": "^11.0.0", "usage": "venue-event-gallery-carousel" },
    { "name": "fancybox", "version": "^3.0.0", "usage": "photo-lightbox-detail-view" }
  ],

  "extraServices": [
    { "name": "payment-gateway", "provider": "stripe-or-iyzico", "purpose": "online-payments" },
    { "name": "identity-service", "provider": "persona", "purpose": "user-verification" },
    { "name": "sms-whatsapp", "provider": "twilio-or-messagebird", "purpose": "appointment-reminders-notifications" },
    { "name": "calendar-integration", "provider": "google-calendar-or-outlook", "purpose": "sync-bookings" }
  ],

  "compliance": [
    "kvkk",
    "gdpr",
    "consumer-protection"
  ],

  "features": [
    "venue-event-management",
    "calendar-scheduling",
    "payment-processing",
    "sms-whatsapp-reminders",
    "user-authentication",
    "ticket-generation",
    "email-notifications",
    "responsive-design"
  ],

  "designGuidelines": {
    "style": "clean-event-focused",
    "typography": "sans-serif-readable",
    "colorPalette": "trust-action-oriented",
    "imagery": "venue-event-photos",
    "animations": "subtle-calendar-interactions"
  },

  "departmentPrompts": {
    "backend": ".NET Web API ile booking backend'i oluştur. MSSQL veritabanı ile randevu, etkinlik ve kullanıcı yönetimi. Stripe/iyzico ödeme, SMS/WhatsApp hatırlatma, Google Calendar entegrasyonu.",
    "frontend": "Nuxt.js ile SSR booking sitesi oluştur. SwiperJS ile mekan/etkinlik galerisi. Takvim bileşeni. Fancybox ile photo lightbox. TailwindCSS ile responsive tasarım yap.",
    "qa": "Takvim çakışma testi, ödeme akışı testi, SMS hatırlatma testi yap.",
    "devops": "Vercel (frontend) + Azure (backend/API) deploy et."
  },

  "performanceTargets": {
    "lighthouse": 85,
    "firstContentfulPaint": "<1.5s",
    "largestContentfulPaint": "<3s",
    "cumulativeLayoutShift": "<0.1"
  },

  "docs": {
    "nuxtjs": [
      { "name": "Ana Dokümantasyon", "url": "https://nuxt.com/docs" },
      { "name": "Getting Started", "url": "https://nuxt.com/docs/getting-started/introduction" }
    ],
    "dotnet-webapi": [
      { "name": "Ana Dokümantasyon", "url": "https://learn.microsoft.com/aspnet/core" },
      { "name": "Create a Web API", "url": "https://learn.microsoft.com/aspnet/core/tutorials/first-web-api" }
    ],
    "mssql": [
      { "name": "Ana Dokümantasyon", "url": "https://learn.microsoft.com/sql" },
      { "name": "T-SQL Tutorial", "url": "https://learn.microsoft.com/sql/t-sql/tutorial-writing-transact-sql-statements" }
    ],
    "stripe": [
      { "name": "Ana Dokümantasyon", "url": "https://docs.stripe.com" },
      { "name": "API Reference", "url": "https://docs.stripe.com/api" },
      { "name": "Getting Started", "url": "https://docs.stripe.com/get-started" }
    ],
    "persona": [
      { "name": "Ana Dokümantasyon", "url": "https://help.withpersona.com" },
      { "name": "API Introduction", "url": "https://docs.withpersona.com/reference/introduction" }
    ],
    "preview-photo": [
      { "name": "Ana Dokümantasyon", "url": "https://unsplash.com/documentation" },
      { "name": "Getting Started", "url": "https://unsplash.com/developers" },
      { "name": "Best Practices", "url": "https://unsplash.com/documentation#search-photos" }
    ]
  }
}
