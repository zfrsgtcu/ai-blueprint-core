{
  "id": "ecommerce",
  "name": "E-Ticaret (B2C/B2B/Multi-Vendor)",
  "description": "Online mağaza, ürün yönetimi, ödeme ve kimlik doğrulama entegrasyonları.",
  "type": "dynamic-ecommerce",

  "stack": {
    "frontend": "nuxt-js",
    "backend": "dotnet-webapi",
    "database": "mssql-natro",
    "deploy": "vercel-azure"
  },

  "uiLibraries": [
    { "name": "tailwindcss", "version": "^3.4.0", "usage": "primary-styling" },
    { "name": "google-fonts", "usage": "typography" },
    { "name": "iconify", "usage": "icons" },
    { "name": "swiperjs", "version": "^11.0.0", "usage": "product-gallery-carousel-zoom" },
    { "name": "fancybox", "version": "^3.0.0", "usage": "product-lightbox-detail-view" },
    { "name": "gsap", "version": "^3.12.0", "usage": "campaign-pages-optional" }
  ],

  "extraServices": [
    { "name": "payment-gateway", "provider": "stripe-or-iyzico", "purpose": "online-payments" },
    { "name": "identity-service", "provider": "persona", "purpose": "user-verification-kyc" }
  ],

  "compliance": [
    "kvkk",
    "gdpr",
    "pci-dss"
  ],

  "features": [
    "product-catalog",
    "shopping-cart",
    "checkout-flow",
    "user-authentication",
    "order-management",
    "payment-integration",
    "inventory-tracking",
    "multi-vendor-support",
    "responsive-design"
  ],

  "designGuidelines": {
    "style": "modern-ecommerce-clean",
    "typography": "sans-serif-readable",
    "colorPalette": "brand-trust-worth",
    "imagery": "product-photos-lifestyle",
    "animations": "subtle-cart-interactions"
  },

  "departmentPrompts": {
    "backend": ".NET Web API ile e-ticaret backend'i oluştur. MSSQL veritabanı ile ürün, sipariş ve kullanıcı yönetimi. Stripe/iyzico ödeme entegrasyonu. Persona kimlik doğrulama servisi.",
    "frontend": "Nuxt.js ile SSR e-ticaret sitesi oluştur. SwiperJS ile ürün galerisi ve zoom. Fancybox ile detay görünümü. TailwindCSS ile responsive tasarım yap.",
    "qa": "Ödeme akışı testi, sepet yönetimi testi, PCI-DSS compliance kontrolü yap.",
    "devops": "Vercel (frontend) + Azure (backend/API) deploy et. MSSQL bağlantısını yapılandır."
  },

  "performanceTargets": {
    "lighthouse": 85,
    "firstContentfulPaint": "<1.5s",
    "largestContentfulPaint": "<3s",
    "cumulativeLayoutShift": "<0.1"
  },

  "docs": {
    "nuxtjs": [
      { "name": "Ana Dokümantasyon", "url": "https://nuxt.com/docs" },
      { "name": "Getting Started", "url": "https://nuxt.com/docs/getting-started/introduction" },
      { "name": "Routing", "url": "https://nuxt.com/docs/getting-started/routing" },
      { "name": "State Management", "url": "https://nuxt.com/docs/getting-started/state-management" },
      { "name": "Server & API Routes", "url": "https://nuxt.com/docs/guide/directory-structure/server" }
    ],
    "dotnet-webapi": [
      { "name": "Ana Dokümantasyon", "url": "https://learn.microsoft.com/aspnet/core" },
      { "name": "Create a Web API", "url": "https://learn.microsoft.com/aspnet/core/tutorials/first-web-api" },
      { "name": "Controllers vs Minimal APIs", "url": "https://learn.microsoft.com/aspnet/core/fundamentals/apis" },
      { "name": "Routing", "url": "https://learn.microsoft.com/aspnet/core/fundamentals/routing" },
      { "name": "Dependency Injection", "url": "https://learn.microsoft.com/aspnet/core/fundamentals/dependency-injection" }
    ],
    "mssql": [
      { "name": "Ana Dokümantasyon", "url": "https://learn.microsoft.com/sql" },
      { "name": "T-SQL Tutorial", "url": "https://learn.microsoft.com/sql/t-sql/tutorial-writing-transact-sql-statements" },
      { "name": "Database Engine Tutorials", "url": "https://learn.microsoft.com/sql/relational-databases/database-engine-tutorials" }
    ],
    "tailwindcss": [
      { "name": "Ana Dokümantasyon", "url": "https://tailwindcss.com/docs" },
      { "name": "Installation", "url": "https://v3.tailwindcss.com/docs/installation" }
    ],
    "stripe": [
      { "name": "Ana Dokümantasyon", "url": "https://docs.stripe.com" },
      { "name": "API Reference", "url": "https://docs.stripe.com/api" },
      { "name": "Getting Started", "url": "https://docs.stripe.com/get-started" },
      { "name": "Payment Intents", "url": "https://docs.stripe.com/payments/payment-intents" }
    ],
    "persona": [
      { "name": "Ana Dokümantasyon", "url": "https://help.withpersona.com" },
      { "name": "API Introduction", "url": "https://docs.withpersona.com/reference/introduction" },
      { "name": "Quick Start", "url": "https://help.withpersona.com/en/articles/quick-start-set-up-your-first-identity-verification-flow" }
    ],
    "vercel": [
      { "name": "Ana Dokümantasyon", "url": "https://vercel.com/docs" },
      { "name": "Getting Started", "url": "https://vercel.com/docs/getting-started" }
    ],
    "azure": [
      { "name": "Ana Dokümantasyon", "url": "https://learn.microsoft.com/azure/app-service" },
      { "name": "Getting Started", "url": "https://docs.azure.cn/app-service/getting-started" },
      { "name": "Deploy ASP.NET Core App", "url": "https://learn.microsoft.com/azure/app-service/tutorial-dotnetcore-sqldb-app" }
    ]
  }
}
